{
  "name": "subtle-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/app.js",
    "build": "vite build",
    "preview": "vite preview",
    "migrate": "node server/persistence/migrate.js",
    "test": "node --test test/*.test.js",
    "test:server": "node --test test/server.test.js",
    "test:postgres": "node --test test/postgres.integration.test.js",
    "test:runtime": "node --test test/runtimePersistence.integration.test.js",
    "test:smoke": "playwright test",
    "test:e2e": "playwright test --config=playwright.e2e.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "vite": "latest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "pg": "^8.23.0"
  }
}

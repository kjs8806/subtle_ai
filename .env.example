# Copy to .env for local use. Never commit a populated .env file.
# See docs/engineering/DEPLOYMENT.md for what each variable controls.

PORT=8787
HOST=127.0.0.1
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5173

# memory (default, ephemeral) or postgres (requires DATABASE_URL; required when
# GMAIL_PROVIDER=google).
PERSISTENCE_PROVIDER=memory
DATABASE_URL=

# mock (default, no external calls) or google (requires the GOOGLE_* and
# TOKEN_ENCRYPTION_KEY values below, plus PERSISTENCE_PROVIDER=postgres).
GMAIL_PROVIDER=mock

SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=
GOOGLE_GMAIL_REDIRECT_URI=

{
  "name": "Flutter",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "remoteUser": "root",
  "containerEnv": {
    "ANDROID_SDK_ROOT": "/opt/android-sdk"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [
    8080
  ],
  "postCreateCommand": "flutter doctor"
}